# =============================================================================
# MODÈLE — copier en .env (ignoré par Git) puis remplir.
#     Copy-Item .env.example .env        (PowerShell — COPIER, pas renommer)
# Ne jamais committer .env.
# =============================================================================

# --- Compte Snowflake --------------------------------------------------------
# Identifiant de compte au format <organisation>-<compte> (Snowsight > menu
# du compte > "Account details" > "Account identifier").
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=SYSADMIN

# --- Objets créés par sql/snowflake/ ----------------------------------------
SNOWFLAKE_WAREHOUSE=NYC_TAXI_WH
SNOWFLAKE_DATABASE=NYC_TAXI_DB

# --- Authentification : remplir UNE des deux options ------------------------
# Option A (recommandée) : paire de clés RSA (voir README §5.2)
DBT_TARGET=keypair
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Docker : clé à placer dans ./.snowflake/ et chemin /app/.snowflake/<fichier>.p8

# Option B : mot de passe -> mettre DBT_TARGET=password
# Si le mot de passe contient $ : guillemets SIMPLES ('...') pour Docker Compose
SNOWFLAKE_PASSWORD=
# Si le compte impose la MFA : SNOWFLAKE_AUTHENTICATOR=username_password_mfa
SNOWFLAKE_AUTHENTICATOR=snowflake

# --- Données du Projet 1 -----------------------------------------------------
# Chemin du CSV nettoyé (relatif à la racine du dépôt ou absolu).
# Avec Docker, ces deux valeurs sont imposées par docker-compose.yml (dossier data/).
P1_CSV_PATH=data/trips_clean.csv
# Optionnel : rapport du Projet 1 pour comparer rows_out au CSV.
P1_TRANSFORM_SUMMARY=data/transform_summary.json
